+def _to_export(station) -> dict:
+    """The drawing tool's export entry of a station, from flatland's Station alone."""
+    entry = {
+        'id': station.id, 'name': station.name, 'city_position': list(station.grid.position), 'city_orientation': station.grid.orientation,
+        'stopping_points': [{'name': sp.name, 'node': list(sp.node)} for sp in station.stopping_points],
+        'edges': [list(cell) for cell in station.edges],
+        'gates': {key: {'name': gate.name, 'pins': {str(k): {'name': pin.name, 'node': list(pin.node)} for k, pin in gate.pins.items()}}
+                  for key, gate in station.gates.items()},
+    }
+    if station.grid.bounding_box is not None:
+        entry['area'] = list(station.grid.bounding_box)
+    return entry
+
