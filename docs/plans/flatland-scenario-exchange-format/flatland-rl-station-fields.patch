+def _bounding_box(city_position: IntVector2D, city_radius: int, height: int, width: int) -> Tuple[int, int, int, int]:
+    """
+    The city's square, `city_radius` around its position, clipped to the grid: (r0, c0, r1, c1), inclusive.
+    """
+    r, c = city_position
+    return max(0, r - city_radius), max(0, c - city_radius), min(height - 1, r + city_radius), min(width - 1, c + city_radius)
+
