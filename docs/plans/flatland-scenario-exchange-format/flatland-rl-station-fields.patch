+def test_stations_links_station_reference_fields():
+    """Each station carries its id (city index), its grid position and orientation as in agents_hints, and a
+    bounding box containing all its edges."""
+    rail, optionals = sparse_rail_generator(max_num_cities=3, seed=1, max_rail_pairs_in_city=2)(30, 30, 2, 0, np.random.RandomState(1))
+    hints = optionals['agents_hints']
+    stations = list(optionals['stations_links'].stations.values())
+    assert [s.id for s in stations] == list(range(len(hints['city_positions'])))
+    assert [s.grid.position for s in stations] == [tuple(p) for p in hints['city_positions']]
+    assert [s.grid.orientation for s in stations] == [int(o) for o in hints['city_orientations']]
+    for s in stations:
+        r0, c0, r1, c1 = s.grid.bounding_box
+        assert all(r0 <= r <= r1 and c0 <= c <= c1 for r, c in s.edges)
+
+
+def test_station_without_reference_fields_is_unchanged():
+    station = Station(name='A', gates={}, stopping_points=[], edges=[])
+    assert (station.id, station.grid) == (None, None)
