+def _pins_reached_through_station(rail: RailGridTransitionMap, station_cells: Set[Tuple[int, int]], pin: Tuple[int, int], heading_in: int,
+                                  target_pins: Set[Tuple[int, int]], heading_out: int) -> Set[Tuple[int, int]]:
+    """The target pins a train entering the station at `pin` with `heading_in` can leave the station from with
+    `heading_out`, moving only through the station's cells."""
+    start = (pin, heading_in)
+    seen = {start}
+    queue = deque([start])
+    reached = set()
+    while queue:
+        cell, heading = queue.popleft()
+        transitions = rail.get_transitions((cell, heading))
+        for new_heading in range(4):
+            if not transitions[new_heading]:
+                continue
+            if cell in target_pins and new_heading == heading_out:
+                reached.add(cell)
+            new_cell = tuple(get_new_position(cell, new_heading))
+            if new_cell in station_cells and (new_cell, new_heading) not in seen:
+                seen.add((new_cell, new_heading))
+                queue.append((new_cell, new_heading))
+    return reached
+
+
+@pytest.mark.parametrize("max_rail_pairs_in_city", [1, 2, 3])
+@pytest.mark.parametrize("max_rails_between_cities", [
+    1, 2,
+    # with three rails between cities, a pin of one gate can miss a pin of the other gate inside a four-track city
+    pytest.param(3, marks=pytest.mark.xfail(reason="sparse cities do not connect every pin of a gate to every pin of the other gate", strict=False)),
+])
+@pytest.mark.parametrize("seed", range(5))
+def test_sparse_rail_generator_gates_connect_all_pins(seed: int, max_rails_between_cities: int, max_rail_pairs_in_city: int):
+    """Up to five cities on a 60x60 grid; a city's gates are keyed by the side (N, E, S, W) its tracks leave it by.
+
+    - For every two gates of a city: a train entering the city through any pin of one gate can leave it through
+      every pin of the other gate, moving only through the city's cells (`Station.edges`).
+    """
+    generate = sparse_rail_generator(max_num_cities=5, seed=seed, max_rail_pairs_in_city=max_rail_pairs_in_city,
+                                     max_rails_between_cities=max_rails_between_cities)
+    rail, optionals = generate(width=60, height=60, num_agents=2, num_resets=0, np_random=RandomState(seed))
+
+    stations = optionals['stations_links'].stations
+    assert len(stations) > 0
+    for station in stations.values():
+        station_cells = {tuple(map(int, cell)) for cell in station.edges}
+        for from_key, from_gate in station.gates.items():
+            for to_key, to_gate in station.gates.items():
+                if from_key == to_key:
+                    continue
+                to_pins = {tuple(map(int, pin.node)) for pin in to_gate.pins.values()}
+                for pin in from_gate.pins.values():
+                    reached = _pins_reached_through_station(rail=rail, station_cells=station_cells, pin=tuple(map(int, pin.node)),
+                                                            heading_in=("NESW".index(from_key) + 2) % 4, target_pins=to_pins,
+                                                            heading_out="NESW".index(to_key))
+                    assert reached == to_pins, (station.name, pin.name, to_gate.name, reached, to_pins)
+
